<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Manual App Store export pinned to the one distribution certificate
	     that the portal's Team Store profile actually lists (259B692C…).
	     Background: this Mac holds TWO "Apple Distribution: Shawn Snyder"
	     identities and the Mac login password is unavailable, so the
	     duplicate cannot be deleted from the keychain. Instead, the portal
	     holds a manually-managed profile named exactly "LMS App Store
	     Manual" that lists ONLY the 259B692C… certificate. With manual
	     signing + that explicit profile, xcodebuild can only pick the
	     listed, locally-installed certificate, so signature and profile
	     always agree (this was failing with "Missing code-signing
	     certificate" (409) under automatic signing). uploadSymbols=false
	     keeps the Tahoe openrsync -E workaround from ExportOptions.plist
	     (same reason). -->
	<key>method</key>
	<string>app-store</string>
	<key>teamID</key>
	<string>K82H7C692L</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>live.leadershipedge.app</key>
		<string>LMS App Store Manual</string>
	</dict>
	<key>destination</key>
	<string>export</string>
	<key>uploadSymbols</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
