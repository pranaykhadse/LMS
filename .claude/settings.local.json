{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "PowerShell(git *)",
      "PowerShell(cd *; git *)",
      "PowerShell(git add .claude/settings.local.json)",
      "PowerShell(git commit -m \"Set dontAsk mode - no permission prompts ever\")",
      "PowerShell(git push origin lms)"
    ],
    "defaultMode": "dontAsk"
  }
}
